PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DEFAULT_CREDIT_DAYS=30

# Generate new random values for every environment. Never commit real secrets.
SESSION_SECRET=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
MONGODB_URI=mongodb://127.0.0.1:27017/suelto_pos

# Optional email delivery
EMAIL_USER=
EMAIL_PASS=

# Optional Google receipt archive / OAuth integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Optional Cloudinary uploads. Keep API secrets on the server only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# =========================================================
# SUELTO POS — Client Environment Variables Template
# =========================================================
# In Vite, only variables prefixed with VITE_ are exposed to
# client-side code. NEVER put private keys or secrets here!
# =========================================================

# Backend Express API Base URL
VITE_API_URL=http://localhost:8000

# Optional: Cloudinary Unsigned Image Upload Settings
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

